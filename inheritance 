class Vehicle:
    def __init__(self,mileage,cost):
        self.mileage=mileage
        self.cost=cost
    def show_details(self):
        print("i am vehical")
        print("mileage of vehical is",self.mileage)
        print("cost of vehicle is",self.cost)
v1=Vehicle(50,500)
v1.show_details()
class Car(Vehicle):
    def show_car(self):
        print("i am a car")
c1=Car(200,200)
c1.show_car()