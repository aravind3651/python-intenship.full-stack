def list_numbers(numbers):
    largest=numbers[0]
    second=None
    for num in numbers:
        if num>largest:
            second=largest
            largest=num
        elif num != largest:
            if second is None or num>second:
                second=num
    return second
numbers=list(map(int,input("enter the list element").split()))
s=list_numbers(numbers)
print(s)